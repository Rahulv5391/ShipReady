# Copy to backend/.env and use with: uv run --env-file .env <command>
DATABASE_URL=postgresql+psycopg://shipready:shipready@localhost:5432/shipready
# Used only by the test suite; its tables are dropped and recreated.
TEST_DATABASE_URL=postgresql+psycopg://shipready:shipready@localhost:5432/shipready_test

# Object storage (S3 API). Locally the storage service in docker-compose.yml; Cloudflare R2 when
# deployed. Create the bucket once with: uv run --env-file .env python -m shipready.storage
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=shipready-dev
S3_ACCESS_KEY_ID=shipready-local
S3_SECRET_ACCESS_KEY=shipready-local-secret
S3_REGION=auto

# Signs and verifies API tokens (HS256, at least 32 bytes). Generate one with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SHIPREADY_JWT_SECRET=

# The worker's queue (docker-compose.yml; Render Key Value when deployed).
REDIS_URL=redis://localhost:6379/0

# Document classification: never (title rules only), fallback (AI when the rules cannot decide)
# or always (AI for every page). Free-tier keys may let the provider keep what is sent, so use
# them with synthetic documents only.
CLASSIFY_WITH_AI=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Field extraction: one request per shipment (free tier: 20 requests a day).
GEMINI_EXTRACT_MODEL=gemini-3.5-flash
