# Copy to web/.env.local and fill in. Never commit .env.local.

# The ShipReady API, called from the server only (pages, actions and the upload relay).
SHIPREADY_API_URL=http://127.0.0.1:8000/api/v1

# Google Picker, for importing files from Google Drive (PLAN.md Section 13.8). The browser sees
# these, so they are restricted in Google Cloud to this site and the Picker API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# The Google Cloud project number (the start of the client ID), not the project ID.
NEXT_PUBLIC_GOOGLE_APP_ID=
